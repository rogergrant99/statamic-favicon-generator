{
    "name": "rogergrant99/statamic-favicon-generator",
    "description": "Generate realfavicon from your Statamic control panel",
    "type": "statamic-addon",
    "keywords": ["statamic-addon","favicon-generator","favicon","realfavicongenerator","realfavicon","real-favicon"],
    "homepage": "https://rogergrant99.de",
    "license": "MIT",
    "authors": [
        {
            "name": "Holger Schillack",
            "email": "hs@rogergrant99.de",
            "homepage": "https://rogergrant99.de",
            "role": "Developer"
        },
        {
            "name": "Jannis Forsthövel",
            "email": "jf@rogergrant99.de",
            "homepage": "https://rogergrant99.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.0",
        "statamic/cms": "6.*"
    },
    "autoload": {
        "psr-4": {
            "rogergrant99\\FaviconGenerator\\": "src"
        }
    },
    "extra": {
        "statamic": {
            "name": "Favicon Generator",
            "description": "Favicon Generator addon"
        },
        "laravel": {
            "providers": [
                "rogergrant99\\FaviconGenerator\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}
